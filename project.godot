; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Split Second"
config/description="Split Second: a first-person parkour shooter."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

UserData="*res://scripts/core/user_data.gd"
InputHub="*res://scripts/core/input_hub.gd"
Sfx="*res://scripts/fx/sfx.gd"
Fx="*res://scripts/fx/fx.gd"
Graphics="*res://scripts/core/graphics.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/aspect="expand"

[shader_globals]

surface_detail={
"type": "float",
"value": 1.0
}
night={
"type": "float",
"value": 0.0
}

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="hitbox"
3d_physics/layer_4="trigger"
3d_render/layer_1="world"
3d_render/layer_11="viewmodel_p1"
3d_render/layer_12="viewmodel_p2"
3d_render/layer_13="viewmodel_p3"
3d_render/layer_14="viewmodel_p4"
3d_render/layer_16="body_p1"
3d_render/layer_17="body_p2"
3d_render/layer_18="body_p3"
3d_render/layer_19="body_p4"

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
